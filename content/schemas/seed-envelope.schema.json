{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/seed-envelope/v1",
  "title": "Seed envelope (docs/08-content-pipeline.md section 4.7)",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "seedId",
    "id",
    "sourceCode",
    "extraction",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "ITEM_SET",
        "GRAMMAR_UNIT",
        "VOCABULARY_UNIT"
      ]
    },
    "seedId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "sourceCode": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object"
    },
    "extraction": {
      "type": "object",
      "required": [
        "scriptVersion",
        "method",
        "reviewed",
        "warnings"
      ],
      "properties": {
        "scriptVersion": {
          "type": "string"
        },
        "method": {
          "enum": [
            "TEXT_LAYER",
            "HTML_DATA",
            "OCR_LLM"
          ]
        },
        "ocrCleaned": {
          "type": "boolean"
        },
        "reviewed": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "itemSet": {
      "type": "object",
      "required": [
        "taskType",
        "examFormat",
        "provenance",
        "topic",
        "skills",
        "payload"
      ],
      "properties": {
        "taskType": {
          "enum": [
            "COMPLETE_THE_WORDS",
            "READ_DAILY_LIFE",
            "READ_ACADEMIC_PASSAGE",
            "LISTEN_CHOOSE_RESPONSE",
            "LISTEN_CONVERSATION",
            "LISTEN_ANNOUNCEMENT",
            "LISTEN_ACADEMIC_TALK",
            "BUILD_A_SENTENCE",
            "WRITE_EMAIL",
            "WRITE_ACADEMIC_DISCUSSION",
            "LISTEN_AND_REPEAT",
            "TAKE_AN_INTERVIEW",
            "GRAMMAR_EXERCISE",
            "VOCAB_EXERCISE",
            "LEGACY_READING",
            "LEGACY_LISTENING"
          ]
        },
        "examFormat": {
          "enum": [
            "TOEFL_2026",
            "LEGACY"
          ]
        },
        "section": {
          "enum": [
            "READING",
            "LISTENING",
            "WRITING",
            "SPEAKING",
            null
          ]
        },
        "provenance": {
          "enum": [
            "EXTRACTED"
          ]
        },
        "cefr": {
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "C2",
            null
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "domain": {
          "enum": [
            "ARTS",
            "LIFE_SCIENCE",
            "SOCIAL_SCIENCE",
            "PHYSICAL_SCIENCE",
            "GENERAL",
            null
          ]
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
          }
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "unit": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ITEM_SET"
          }
        }
      },
      "then": {
        "required": [
          "itemSet"
        ]
      },
      "else": {
        "required": [
          "unit"
        ]
      }
    }
  ]
}
