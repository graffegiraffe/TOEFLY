{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/WRITE_ACADEMIC_DISCUSSION/v1",
  "title": "WRITE_ACADEMIC_DISCUSSION (docs/03-domain-model.md section 4.10)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "professor",
        "students",
        "minWords",
        "timeLimitSeconds"
      ],
      "properties": {
        "course": {
          "type": "string"
        },
        "professor": {
          "type": "object",
          "required": [
            "name",
            "post"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "post": {
              "type": "string",
              "minLength": 40
            }
          },
          "additionalProperties": false
        },
        "students": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "post"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "post": {
                "type": "string",
                "minLength": 40
              }
            },
            "additionalProperties": false
          }
        },
        "minWords": {
          "const": 100
        },
        "timeLimitSeconds": {
          "const": 600
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "rubricId",
          "maxScore",
          "keyPoints",
          "modelAnswers"
        ],
        "properties": {
          "ordinal": {
            "const": 1
          },
          "rubricId": {
            "type": "string"
          },
          "maxScore": {
            "const": 5
          },
          "keyPoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "modelAnswers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "source"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": [
                    "BOOK",
                    "TUTOR",
                    "AI"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
