{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/READ_DAILY_LIFE/v1",
  "title": "READ_DAILY_LIFE (docs/03-domain-model.md section 4.2; EXTRACTED emails need only Subject in headers)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "genre",
        "title",
        "wordCount"
      ],
      "properties": {
        "genre": {
          "enum": [
            "EMAIL",
            "NOTICE",
            "MENU",
            "CHAT",
            "SOCIAL_POST",
            "ADVERTISEMENT",
            "SCHEDULE"
          ]
        },
        "title": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "sender",
              "text"
            ],
            "properties": {
              "sender": {
                "type": "string"
              },
              "time": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "wordCount": {
          "type": "integer",
          "minimum": 15,
          "maximum": 150
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "body"
          ]
        },
        {
          "required": [
            "messages"
          ]
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "subskill",
          "prompt",
          "options",
          "answerKey",
          "explanation"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "subskill": {
            "enum": [
              "MAIN_IDEA",
              "DETAIL",
              "INFERENCE",
              "PURPOSE",
              "VOCABULARY"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "key",
                "text",
                "rationale"
              ],
              "properties": {
                "key": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false
            }
          },
          "answerKey": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "explanation": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
