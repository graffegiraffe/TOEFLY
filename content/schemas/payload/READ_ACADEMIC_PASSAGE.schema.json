{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/READ_ACADEMIC_PASSAGE/v1",
  "title": "READ_ACADEMIC_PASSAGE (docs/03-domain-model.md section 4.3)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "title",
        "domain",
        "paragraphs",
        "wordCount"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "ARTS",
            "LIFE_SCIENCE",
            "SOCIAL_SCIENCE",
            "PHYSICAL_SCIENCE",
            "GENERAL"
          ]
        },
        "paragraphs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wordCount": {
          "type": "integer",
          "minimum": 100,
          "maximum": 500
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "subskill",
          "prompt",
          "options",
          "answerKey",
          "explanation"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "subskill": {
            "enum": [
              "FACTUAL",
              "VOCABULARY",
              "RHETORICAL_PURPOSE",
              "INFERENCE",
              "INSERT_SENTENCE"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "key",
                "text",
                "rationale"
              ],
              "properties": {
                "key": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false
            }
          },
          "answerKey": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "explanation": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "targetWord": {
            "type": "object",
            "required": [
              "paragraph",
              "charStart",
              "charEnd",
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "paragraph": {
                "type": "integer",
                "minimum": 0
              },
              "charStart": {
                "type": "integer",
                "minimum": 0
              },
              "charEnd": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "insertion": {
            "type": "object",
            "required": [
              "sentence",
              "markers"
            ],
            "properties": {
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "markers": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "key",
                    "paragraph",
                    "afterSentence"
                  ],
                  "properties": {
                    "key": {
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "paragraph": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "afterSentence": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "subskill": {
                  "const": "INSERT_SENTENCE"
                }
              },
              "required": [
                "subskill"
              ]
            },
            "then": {
              "required": [
                "insertion"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
