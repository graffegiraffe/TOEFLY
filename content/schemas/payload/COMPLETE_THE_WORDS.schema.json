{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/COMPLETE_THE_WORDS/v1",
  "title": "COMPLETE_THE_WORDS (docs/03-domain-model.md section 4.1; the explanation of a gap is optional for EXTRACTED sets)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "title",
        "markup",
        "wordCount"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "markup": {
          "type": "string",
          "minLength": 100
        },
        "wordCount": {
          "type": "integer",
          "minimum": 50,
          "maximum": 120
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "gapId",
          "prefix",
          "suffix",
          "fullWord",
          "answerKey"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "gapId": {
            "type": "string",
            "pattern": "^g(10|[1-9])$"
          },
          "prefix": {
            "type": "string",
            "pattern": "^[A-Za-z'\u2019-]+$"
          },
          "suffix": {
            "type": "string",
            "pattern": "^[A-Za-z'\u2019-]+$"
          },
          "fullWord": {
            "type": "string"
          },
          "answerKey": {
            "type": "string",
            "pattern": "^[A-Za-z'\u2019-]+\\{[A-Za-z'\u2019-]+\\}$"
          },
          "acceptedAnswers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
