{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/LISTEN_AND_REPEAT/v1",
  "title": "LISTEN_AND_REPEAT (docs/03-domain-model.md section 4.11; EXTRACTED: no picture, TTS audio)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "scenario"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object"
        },
        "scenarioAudio": {
          "type": "object",
          "required": [
            "origin",
            "accent",
            "durationSeconds"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "origin": {
              "enum": [
                "HOSTED_MP3",
                "TTS"
              ]
            },
            "accent": {
              "enum": [
                "US",
                "CA",
                "UK",
                "AU"
              ]
            },
            "durationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "durationEstimated": {
              "type": "boolean"
            },
            "voiceId": {
              "type": "string"
            },
            "ttsFallbackKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "text",
          "wordCount",
          "audio"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "wordCount": {
            "type": "integer",
            "minimum": 3,
            "maximum": 25
          },
          "audio": {
            "type": "object",
            "required": [
              "origin",
              "accent",
              "durationSeconds"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "HOSTED_MP3",
                  "TTS"
                ]
              },
              "accent": {
                "enum": [
                  "US",
                  "CA",
                  "UK",
                  "AU"
                ]
              },
              "durationSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "durationEstimated": {
                "type": "boolean"
              },
              "voiceId": {
                "type": "string"
              },
              "ttsFallbackKey": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "responseSeconds": {
            "type": "integer",
            "minimum": 8,
            "maximum": 12
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
