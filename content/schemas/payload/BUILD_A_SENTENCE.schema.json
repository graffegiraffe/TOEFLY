{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/BUILD_A_SENTENCE/v1",
  "title": "BUILD_A_SENTENCE (docs/03-domain-model.md section 4.8; EXTRACTED: no explanation, up to two unused chunks, fewer than 10 items when the book is inconsistent)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "contextLine",
          "template",
          "chunks",
          "answerKey",
          "acceptedKeys",
          "distractorChunkId",
          "sentence"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "contextLine": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "array",
            "minItems": 2,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "FIXED"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "slotId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "SLOT"
                    },
                    "slotId": {
                      "type": "string",
                      "pattern": "^s[1-9]$"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "chunks": {
            "type": "array",
            "minItems": 2,
            "maxItems": 9,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^c[1-9]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "answerKey": {
            "type": "array",
            "minItems": 2,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^c[1-9]$"
            }
          },
          "acceptedKeys": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^c[1-9]$"
              }
            }
          },
          "distractorChunkId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^c[1-9]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sentence": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "grammarFocus": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
