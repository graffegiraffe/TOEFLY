{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/WRITE_EMAIL/v1",
  "title": "WRITE_EMAIL (docs/03-domain-model.md section 4.9)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "scenario",
        "recipient",
        "subject",
        "bullets",
        "timeLimitSeconds"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "relationship": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "timeLimitSeconds": {
          "const": 420
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "rubricId",
          "maxScore",
          "keyPoints",
          "modelAnswers"
        ],
        "properties": {
          "ordinal": {
            "const": 1
          },
          "rubricId": {
            "type": "string"
          },
          "maxScore": {
            "const": 5
          },
          "keyPoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "modelAnswers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "source"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": [
                    "BOOK",
                    "TUTOR",
                    "AI"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
