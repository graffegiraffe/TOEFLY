{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/LEGACY_LISTENING/v1",
  "title": "LEGACY_LISTENING (docs/03-domain-model.md section 4.16; EXTRACTED: audio is synthesised from the transcript, its length is estimated)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "title",
        "domain",
        "contextLine",
        "speakers",
        "transcript",
        "audio",
        "wordCount"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "ARTS",
            "LIFE_SCIENCE",
            "SOCIAL_SCIENCE",
            "PHYSICAL_SCIENCE",
            "GENERAL"
          ]
        },
        "contextLine": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "role": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "transcript": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "speaker",
              "text"
            ],
            "properties": {
              "speaker": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "audio": {
          "type": "object",
          "required": [
            "origin",
            "accent",
            "durationSeconds"
          ],
          "properties": {
            "origin": {
              "const": "TTS"
            },
            "accent": {
              "enum": [
                "US",
                "CA",
                "UK",
                "AU"
              ]
            },
            "durationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "durationEstimated": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "wordCount": {
          "type": "integer",
          "minimum": 50
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "subskill",
          "prompt",
          "options",
          "answerKey",
          "explanation"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "subskill": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "key",
                "text",
                "rationale"
              ],
              "properties": {
                "key": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false
            }
          },
          "answerKey": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "explanation": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
