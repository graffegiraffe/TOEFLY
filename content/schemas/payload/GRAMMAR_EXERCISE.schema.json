{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/payload/GRAMMAR_EXERCISE/v1",
  "title": "GRAMMAR_EXERCISE (docs/03-domain-model.md section 4.13; options may carry the placeholder rationale of docs/08 section 4.5)",
  "type": "object",
  "required": [
    "stimulus",
    "items"
  ],
  "properties": {
    "stimulus": {
      "type": "object",
      "required": [
        "instructions",
        "unitRef"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "unitRef": {
          "type": "object",
          "required": [
            "framework",
            "topicTitle"
          ],
          "properties": {
            "framework": {
              "enum": [
                "ROUND_UP_5",
                "COLLINS_GRAMMAR",
                "CUSTOM"
              ]
            },
            "unitNo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "topicTitle": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ordinal",
              "exerciseType",
              "sentence",
              "answerKey",
              "acceptedAnswers",
              "grammarTopic",
              "explanation"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "exerciseType": {
                "const": "GAP_FILL"
              },
              "sentence": {
                "type": "string",
                "pattern": "___"
              },
              "hint": {
                "type": "string"
              },
              "answerKey": {
                "type": "string",
                "minLength": 1
              },
              "acceptedAnswers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "grammarTopic": {
                "type": "string",
                "pattern": "^(RU(0[1-9]|1[0-5])|CG(0[1-9]|1[0-9]|20))\\.[A-Z0-9_]+$"
              },
              "explanation": {
                "$ref": "#/$defs/explanation"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "ordinal",
              "exerciseType",
              "sentence",
              "options",
              "answerKey",
              "grammarTopic",
              "explanation"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "exerciseType": {
                "const": "MULTIPLE_CHOICE"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/option"
                }
              },
              "answerKey": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "grammarTopic": {
                "type": "string",
                "pattern": "^(RU(0[1-9]|1[0-5])|CG(0[1-9]|1[0-9]|20))\\.[A-Z0-9_]+$"
              },
              "explanation": {
                "$ref": "#/$defs/explanation"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "ordinal",
              "exerciseType",
              "source",
              "keyWord",
              "template",
              "answerKey",
              "acceptedAnswers",
              "aiCheckOnMismatch",
              "grammarTopic",
              "explanation"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "exerciseType": {
                "const": "TRANSFORMATION"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "keyWord": {
                "type": "string",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "pattern": "___"
              },
              "answerKey": {
                "type": "string",
                "minLength": 1
              },
              "acceptedAnswers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "aiCheckOnMismatch": {
                "const": true
              },
              "grammarTopic": {
                "type": "string",
                "pattern": "^(RU(0[1-9]|1[0-5])|CG(0[1-9]|1[0-9]|20))\\.[A-Z0-9_]+$"
              },
              "explanation": {
                "$ref": "#/$defs/explanation"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "ordinal",
              "exerciseType",
              "sentence",
              "fragments",
              "errorKey",
              "correction",
              "grammarTopic",
              "explanation"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "exerciseType": {
                "const": "ERROR_CORRECTION"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "fragments": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "key",
                    "text"
                  ],
                  "properties": {
                    "key": {
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "errorKey": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "correction": {
                "type": "string",
                "minLength": 1
              },
              "grammarTopic": {
                "type": "string",
                "pattern": "^(RU(0[1-9]|1[0-5])|CG(0[1-9]|1[0-9]|20))\\.[A-Z0-9_]+$"
              },
              "explanation": {
                "$ref": "#/$defs/explanation"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "explanation": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "evidence": {
          "type": "string"
        },
        "ruleRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "key",
        "text",
        "rationale"
      ],
      "properties": {
        "key": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    }
  }
}
