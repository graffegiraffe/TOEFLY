{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.toefly.app/content/grammar-unit/v1",
  "title": "GRAMMAR_UNIT (docs/08-content-pipeline.md section 7.1; rule card and exercises are not extracted yet)",
  "type": "object",
  "required": [
    "framework",
    "unitNo",
    "title",
    "topicCodes",
    "exercises"
  ],
  "properties": {
    "framework": {
      "enum": [
        "ROUND_UP_5",
        "COLLINS_GRAMMAR"
      ]
    },
    "unitNo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topicCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "ruleCard": {
      "type": [
        "object",
        "null"
      ]
    },
    "progressCheckNo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "exercises": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
