---
/*
 * The hero is laid out like a tutor's week page (docs/07 P2): a cover banner, a big title, then the page properties.
 * Here the properties describe the method instead of a single week.
 */
import Cover from '../Cover.astro';
import Screenshot from '../Screenshot.astro';
import { heroScreenshot } from '../../data/screenshots';
import { appLink } from '../../data/site';

const properties = [
  { term: 'Plan', detail: '1 to 16 weeks, counted back from your exam date' },
  { term: 'Every day', detail: 'A short list for today across all four skills, grammar and vocabulary' },
  { term: 'After each task', detail: 'A review that explains your answer and every wrong option' },
  { term: 'Your score', detail: 'Predicted band 1 to 6, CEFR and 0 to 120, always marked as an AI estimate' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="mesh" aria-hidden="true">
    <i class="b1"></i>
    <i class="b2"></i>
    <i class="b3"></i>
    <i class="b4"></i>
  </div>
  <div class="wrap inner">
    <Cover class="hero-cover" />
    <div class="head">
      <div class="lead">
        <h1 id="hero-title">Prepare for the new TOEFL iBT like you have a personal tutor.</h1>
        <p class="sub">
          A plan for every week, feedback after every task and real mock exams with adaptive sections. Built for the
          2026 format.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href={appLink('/sign-up')}>
            Start free
          </a>
          <a class="btn btn-secondary" href={appLink('/sign-up?role=tutor')}>
            I'm a tutor
          </a>
        </div>
        <p class="note">Free plan, no card. Pro is free for the first 7 days.</p>
      </div>
      <dl class="props">
        {properties.map((p) => (
          <div class="prop">
            <dt>{p.term}</dt>
            <dd>{p.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
    <figure class="shot">
      <Screenshot
        shot={heroScreenshot}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1184px) 1120px, calc(100vw - 32px)"
        priority
      />
      <figcaption class="visually-hidden">{heroScreenshot.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: 20px;
    padding-bottom: 24px;
  }

  /*
   * mesh-landing (docs/07 §2.5): four soft circles drifting over 40 s; static with reduced motion. The blur is baked
   * into radial gradients instead of filter: blur(60px), so the drift only moves composited layers and costs no paint.
   */
  .mesh {
    position: absolute;
    inset: 0 0 25% 0;
    z-index: -1;
    overflow: hidden;
    background: var(--mesh-bg);
    pointer-events: none;
  }

  .mesh i {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      var(--c) 0%,
      color-mix(in srgb, var(--c) 55%, transparent) 45%,
      transparent 100%
    );
    opacity: calc(var(--o) * var(--mesh-opacity));
    will-change: transform;
    animation: drift 40s ease-in-out infinite alternate;
  }

  .mesh .b1 {
    --o: 0.55;
    width: 500px;
    height: 500px;
    --c: #04ac6a;
    left: -160px;
    top: 40px;
  }

  .mesh .b2 {
    --o: 0.9;
    width: 460px;
    height: 460px;
    --c: #b6f0cf;
    right: -60px;
    top: 38%;
    animation-delay: -12s;
  }

  .mesh .b3 {
    --o: 0.4;
    width: 420px;
    height: 420px;
    --c: #08945b;
    left: 40%;
    bottom: -140px;
    animation-delay: -24s;
  }

  .mesh .b4 {
    --o: 0.7;
    width: 380px;
    height: 380px;
    --c: #b6f0cf;
    left: 20%;
    top: 46%;
    animation-delay: -6s;
  }

  .mesh::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 160px;
    background: linear-gradient(to bottom, transparent, var(--canvas));
  }

  @keyframes drift {
    to {
      transform: translate3d(60px, -40px, 0) scale(1.08);
    }
  }

  .inner :global(.hero-cover) {
    height: 120px;
  }

  .head {
    display: grid;
    gap: 32px;
    padding-top: 28px;
  }

  h1 {
    font-size: clamp(2rem, 1.35rem + 2.8vw, 3.25rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  .sub {
    margin-top: 18px;
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .note {
    margin-top: 14px;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  /* Page properties, as on the Week page: label column, value column, hairline rows. */
  .props {
    align-self: end;
    border-top: 1px solid var(--border);
  }

  .prop {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  dt {
    color: var(--ink-muted);
  }

  .shot {
    margin-top: 48px;
  }

  .shot :global(img) {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 640px) {
    .inner :global(.hero-cover) {
      height: 160px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: 28px;
    }

    .inner :global(.hero-cover) {
      height: 200px;
    }

    .head {
      grid-template-columns: 1.25fr 1fr;
      gap: 64px;
      padding-top: 36px;
    }
  }
</style>
