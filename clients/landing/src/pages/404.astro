---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on TOEFLY.">
  <section class="wrap nf">
    <h1>This page does not exist.</h1>
    <p>The link may be old or mistyped.</p>
    <a class="btn btn-primary" href="/">
      Go to the home page
    </a>
  </section>
</Base>

<style>
  .nf {
    padding-block: 96px;
    max-width: calc(640px + var(--gutter) * 2);
  }
  h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
  }
  p {
    margin: 12px 0 28px;
    color: var(--ink-muted);
  }
</style>
