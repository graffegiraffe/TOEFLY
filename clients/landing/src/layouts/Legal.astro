---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  version: string;
}

const { title, description, updated, version } = Astro.props;
---

<Base title={title} description={description}>
  <article class="wrap legal">
    <header>
      <h1>{title}</h1>
      <p class="meta">
        Version {version}, last updated{' '}
        <time datetime={updated}>
          {new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </p>
      <p class="draft">
        TOEFLY is a diploma project in development. Payments run in test mode. This text describes how the service
        handles data today and will be reviewed before a public launch.
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: calc(720px + var(--gutter) * 2);
    padding-block: 48px 88px;
  }

  h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .meta {
    margin-top: 10px;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .draft {
    margin-top: 20px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-on-soft);
    font-size: 0.875rem;
  }

  .prose {
    margin-top: 32px;
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin-top: 40px;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(table) {
    margin-top: 12px;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(.table-wrap) {
    overflow-x: auto;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    font-weight: 600;
  }
</style>
