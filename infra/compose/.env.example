# Copy to infra/compose/.env (ignored by Git). Values below are safe for a laptop only.
GH_OWNER=graffegiraffe

# Host port of PostgreSQL; change it when a local PostgreSQL already uses 5432 (services read TOEFLY_POSTGRES_PORT).
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres-local
DEBEZIUM_PASSWORD=debezium-local
APICURIO_DB_PASSWORD=apicurio-local
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_PASSWORD=admin-local
TOEFLY_WEB_BFF_SECRET=web-bff-local-secret
# Signs the web session cookie of api-gateway (at least 32 characters).
GATEWAY_SESSION_KEY=local-gateway-session-key-change-me-0123456789

# Google sign-in: an OAuth client of type Web application with the redirect URI
# http://localhost:8180/realms/toefly/broker/google/endpoint (docs/12-implementation-plan.md §8).
GOOGLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keycloak mail goes to Mailpit (http://localhost:8025) unless Brevo SMTP is set:
# KEYCLOAK_SMTP_HOST=smtp-relay.brevo.com, KEYCLOAK_SMTP_PORT=587, KEYCLOAK_SMTP_AUTH=true, KEYCLOAK_SMTP_STARTTLS=true.
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=
KEYCLOAK_SMTP_AUTH=
KEYCLOAK_SMTP_STARTTLS=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_FROM=

# Service database passwords default to the role name (profile_app, practice_app, ...) in local only.

# Optional external AI keys; without them ai-gateway falls back to Ollama.
GROQ_API_KEY=
# Extra free vision models for content/scripts (book extraction); each one is used when its key is set,
# in the order of TOEFLY_LLM_PROVIDERS, and the next one takes over when a quota runs out.
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter has no default: name a free vision model, e.g. one with the :free suffix.
OPENROUTER_MODEL=
TOEFLY_LLM_PROVIDERS=groq,gemini,mistral,openrouter
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Native Ollama on macOS (Metal) instead of the `ai` profile:
OLLAMA_BASE_URL=http://host.docker.internal:11434
