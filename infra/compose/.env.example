# Copy to infra/compose/.env (ignored by Git). Values below are safe for a laptop only.
GH_OWNER=graffegiraffe

# Host port of PostgreSQL; change it when a local PostgreSQL already uses 5432 (services read TOEFLY_POSTGRES_PORT).
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres-local
DEBEZIUM_PASSWORD=debezium-local
APICURIO_DB_PASSWORD=apicurio-local
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_PASSWORD=admin-local
TOEFLY_WEB_BFF_SECRET=web-bff-local-secret

# Service database passwords default to the role name (profile_app, practice_app, ...) in local only.

# Optional external AI keys; without them ai-gateway falls back to Ollama.
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Native Ollama on macOS (Metal) instead of the `ai` profile:
OLLAMA_BASE_URL=http://host.docker.internal:11434
