{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "days",
    "weekGoal",
    "focusExplanation"
  ],
  "properties": {
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "tasks"
        ],
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidateRef",
                "whyForYou"
              ],
              "properties": {
                "candidateRef": {
                  "type": "string",
                  "pattern": "^c[0-9]{2,3}$"
                },
                "whyForYou": {
                  "type": "string",
                  "maxLength": 140
                }
              }
            }
          }
        }
      }
    },
    "weekGoal": {
      "type": "string",
      "maxLength": 160
    },
    "focusExplanation": {
      "type": "string",
      "maxLength": 500
    }
  }
}
