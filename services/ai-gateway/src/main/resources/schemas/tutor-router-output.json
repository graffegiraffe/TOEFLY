{
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "language", "explicitUserRequest", "escalate", "needsScreenContext"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["EXPLAIN_MISTAKE", "WRITING_FEEDBACK", "SPEAKING_FEEDBACK", "GRAMMAR_QUESTION", "VOCABULARY_QUESTION",
        "PLAN_QUESTION", "PROGRESS_QUESTION", "STRATEGY_QUESTION", "MOTIVATION", "PRACTICE_REQUEST", "SOLVE_IN_PROGRESS",
        "OFF_TOPIC"]
    },
    "language": { "type": "string", "enum": ["EN", "RU"] },
    "explicitUserRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addWord", "showAnswer", "assignTask"],
      "properties": {
        "addWord": { "type": "boolean" },
        "showAnswer": { "type": "boolean" },
        "assignTask": { "type": "boolean" }
      }
    },
    "escalate": { "type": "boolean" },
    "needsScreenContext": { "type": "boolean" }
  }
}
