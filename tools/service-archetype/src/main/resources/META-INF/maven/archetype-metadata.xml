<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
                      name="toefly-service">
    <requiredProperties>
        <requiredProperty key="serviceShort"/>
        <requiredProperty key="topicSegment"/>
        <requiredProperty key="servicePort"/>
        <requiredProperty key="dbName"/>
        <requiredProperty key="dbRole"/>
        <requiredProperty key="applicationClass"/>
    </requiredProperties>
    <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes><include>**/*.java</include></includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes><include>**/*.java</include></includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes><include>**/*</include></includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/openapi</directory>
            <includes><include>**/*</include></includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/avro</directory>
            <includes><include>**/*</include></includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>helm</directory>
            <includes><include>**/*</include></includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
