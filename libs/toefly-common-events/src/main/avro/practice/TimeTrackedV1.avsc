{
  "type": "record",
  "name": "TimeTrackedV1",
  "namespace": "com.toefly.events.practice",
  "doc": "Active time of a closed attempt was recorded (toefly.practice.time-tracked.v1).",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "CloudEvents id; equals outbox_event.id and is the idempotency key of consumers."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Moment the domain fact happened, UTC milliseconds; equals ce_time."
    },
    {
      "name": "userId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Learner the event is about (sub of Keycloak); equals the partition key."
    },
    {
      "name": "correlationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "End-to-end chain identifier; equals ce_correlationid."
    },
    {
      "name": "causationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "ce_id of the event that caused this one; equals ce_causationid."
    },
    {
      "name": "attemptId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Attempt the time belongs to."
    },
    {
      "name": "taskType",
      "type": {
        "type": "enum",
        "name": "TaskType",
        "namespace": "com.toefly.events.common",
        "doc": "Task type (docs/00-README.md section 5.1).",
        "symbols": [
          "UNKNOWN",
          "COMPLETE_THE_WORDS",
          "READ_DAILY_LIFE",
          "READ_ACADEMIC_PASSAGE",
          "LISTEN_CHOOSE_RESPONSE",
          "LISTEN_CONVERSATION",
          "LISTEN_ANNOUNCEMENT",
          "LISTEN_ACADEMIC_TALK",
          "BUILD_A_SENTENCE",
          "WRITE_EMAIL",
          "WRITE_ACADEMIC_DISCUSSION",
          "LISTEN_AND_REPEAT",
          "TAKE_AN_INTERVIEW",
          "GRAMMAR_EXERCISE",
          "VOCAB_EXERCISE",
          "LEGACY_READING",
          "LEGACY_LISTENING"
        ],
        "default": "UNKNOWN"
      },
      "doc": "Task type."
    },
    {
      "name": "section",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "Section",
          "namespace": "com.toefly.events.common",
          "doc": "Exam section.",
          "symbols": [
            "UNKNOWN",
            "READING",
            "LISTENING",
            "WRITING",
            "SPEAKING"
          ],
          "default": "UNKNOWN"
        }
      ],
      "default": null,
      "doc": "Section; null for grammar and vocabulary exercises."
    },
    {
      "name": "weekSection",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "WeekSection name of the task: READING, LISTENING, WRITING, SPEAKING, GRAMMAR or VOCABULARY."
    },
    {
      "name": "localDate",
      "type": {
        "type": "int",
        "logicalType": "date"
      },
      "doc": "Calendar day of the learner when the attempt started."
    },
    {
      "name": "activeSeconds",
      "type": "int",
      "doc": "Active seconds, never more than the wall-clock time of the attempt."
    },
    {
      "name": "itemCount",
      "type": "int",
      "doc": "Items in the attempt."
    },
    {
      "name": "suspicious",
      "type": "boolean",
      "default": false,
      "doc": "Active time deviates from the wall clock by more than 5%; excluded from pace ratios."
    }
  ]
}
