{
  "type": "record",
  "name": "EntitlementsChangedV1",
  "namespace": "com.toefly.events.billing",
  "doc": "Full snapshot of the rights of a user (toefly.billing.entitlements-changed.v1, compacted).",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "CloudEvents id; equals outbox_event.id; the idempotency key of consumers."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Moment the domain fact happened, UTC milliseconds; equals ce_time."
    },
    {
      "name": "userId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "User the event is about (sub of Keycloak); equals the partition key."
    },
    {
      "name": "correlationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "End-to-end chain identifier (request or saga); equals ce_correlationid."
    },
    {
      "name": "causationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "ce_id of the event that caused this one; equals ce_causationid."
    },
    {
      "name": "entitlementsVersion",
      "type": "long",
      "doc": "Monotonic snapshot version; consumers ignore snapshots with a lower version."
    },
    {
      "name": "planTierCode",
      "type": {
        "type": "enum",
        "name": "PlanTierCode",
        "namespace": "com.toefly.events.common",
        "doc": "Plan tier (docs/00-README.md section 5.2).",
        "symbols": [
          "UNKNOWN",
          "STUDENT_FREE",
          "STUDENT_PRO",
          "TUTOR",
          "TUTOR_PLUS"
        ],
        "default": "UNKNOWN"
      },
      "doc": "Effective plan tier."
    },
    {
      "name": "entitlements",
      "type": {
        "type": "array",
        "items": {
          "type": "enum",
          "name": "Entitlement",
          "namespace": "com.toefly.events.common",
          "doc": "Access right (docs/02 section 1.3).",
          "symbols": [
            "UNKNOWN",
            "UNLIMITED_WEEKS",
            "AI_WRITING_CHECK",
            "AI_SPEAKING_CHECK",
            "SPEAKING",
            "MOCK_EXAM",
            "AI_TUTOR_CHAT",
            "WEEKLY_REVIEW",
            "TUTOR_WORKSPACE",
            "TUTOR_MATERIALS"
          ],
          "default": "UNKNOWN"
        }
      },
      "doc": "Full set of active rights."
    },
    {
      "name": "grants",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "EntitlementGrantV1",
          "namespace": "com.toefly.events.billing",
          "doc": "A right with its source, limit and term.",
          "fields": [
            {
              "name": "entitlement",
              "type": "com.toefly.events.common.Entitlement",
              "doc": "Right."
            },
            {
              "name": "source",
              "type": {
                "type": "enum",
                "name": "EntitlementSource",
                "namespace": "com.toefly.events.common",
                "doc": "Source of a right (docs/00-README.md section 5.2).",
                "symbols": [
                  "UNKNOWN",
                  "SUBSCRIPTION",
                  "TRIAL",
                  "SEAT",
                  "MANUAL"
                ],
                "default": "UNKNOWN"
              },
              "doc": "Source of the right."
            },
            {
              "name": "limit",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "Usage limit (10 AI checks of Free); null means no limit."
            },
            {
              "name": "used",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "Used within the limit."
            },
            {
              "name": "validUntil",
              "type": [
                "null",
                {
                  "type": "long",
                  "logicalType": "timestamp-millis"
                }
              ],
              "default": null,
              "doc": "Valid until, UTC; null while the source is active."
            }
          ]
        }
      },
      "default": [],
      "doc": "The same rights with source, limit and term."
    },
    {
      "name": "tutorId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "Tutor who gave the seat (source SEAT)."
    },
    {
      "name": "trialEndsAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "End of the Pro trial, UTC."
    },
    {
      "name": "changedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Moment the rights were recalculated, UTC."
    }
  ]
}
