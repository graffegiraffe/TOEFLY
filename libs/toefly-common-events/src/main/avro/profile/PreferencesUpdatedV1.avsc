{
  "type": "record",
  "name": "PreferencesUpdatedV1",
  "namespace": "com.toefly.events.profile",
  "doc": "Full snapshot of the learner's preferences after a change (toefly.profile.preferences-updated.v1, compacted).",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "CloudEvents id; the idempotency key of consumers."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Moment the domain fact happened, UTC milliseconds; equals ce_time."
    },
    {
      "name": "userId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "User the event is about (sub of Keycloak); equals the partition key."
    },
    {
      "name": "correlationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "End-to-end chain identifier; equals ce_correlationid."
    },
    {
      "name": "causationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "ce_id of the event that caused this one; equals ce_causationid."
    },
    {
      "name": "timezone",
      "type": "string",
      "doc": "IANA time zone of the learner's day, for example Europe/Minsk."
    },
    {
      "name": "explanationLanguage",
      "type": "string",
      "doc": "Language of AI explanations: en or ru."
    },
    {
      "name": "minutesPerDay",
      "type": "int",
      "doc": "Planned study minutes per day, 15 to 180."
    },
    {
      "name": "preferredStudyTime",
      "type": "string",
      "doc": "Local time of the daily reminder, HH:mm."
    }
  ]
}
