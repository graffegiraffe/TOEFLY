{
  "type": "record",
  "name": "WeekTaskCompletedV1",
  "namespace": "com.toefly.events.planning",
  "doc": "A task of the week is done (toefly.planning.week-task-completed.v1).",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "CloudEvents id; equals outbox_event.id and is the idempotency key of consumers."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Moment the domain fact happened, UTC milliseconds; equals ce_time."
    },
    {
      "name": "userId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Learner the event is about (sub of Keycloak); equals the partition key."
    },
    {
      "name": "correlationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "End-to-end chain identifier; equals ce_correlationid."
    },
    {
      "name": "causationId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "ce_id of the event that caused this one; equals ce_causationid."
    },
    {
      "name": "weekId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Week."
    },
    {
      "name": "weekTaskId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Week task."
    },
    {
      "name": "weekNo",
      "type": "int",
      "doc": "Week number."
    },
    {
      "name": "kind",
      "type": {
        "type": "enum",
        "name": "WeekTaskKind",
        "namespace": "com.toefly.events.common",
        "doc": "Kind of a week task.",
        "symbols": [
          "UNKNOWN",
          "ITEM_SET",
          "GRAMMAR_UNIT",
          "VOCABULARY_UNIT",
          "VOCABULARY_REVIEW",
          "TUTOR_MATERIAL",
          "EXTERNAL_RESOURCE",
          "MOCK_EXAM"
        ],
        "default": "UNKNOWN"
      },
      "doc": "Kind of the task."
    },
    {
      "name": "taskType",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "TaskType",
          "namespace": "com.toefly.events.common",
          "doc": "Task type (docs/00-README.md section 5.1).",
          "symbols": [
            "UNKNOWN",
            "COMPLETE_THE_WORDS",
            "READ_DAILY_LIFE",
            "READ_ACADEMIC_PASSAGE",
            "LISTEN_CHOOSE_RESPONSE",
            "LISTEN_CONVERSATION",
            "LISTEN_ANNOUNCEMENT",
            "LISTEN_ACADEMIC_TALK",
            "BUILD_A_SENTENCE",
            "WRITE_EMAIL",
            "WRITE_ACADEMIC_DISCUSSION",
            "LISTEN_AND_REPEAT",
            "TAKE_AN_INTERVIEW",
            "GRAMMAR_EXERCISE",
            "VOCAB_EXERCISE",
            "LEGACY_READING",
            "LEGACY_LISTENING"
          ],
          "default": "UNKNOWN"
        }
      ],
      "default": null,
      "doc": "Task type; null for units, resources and reviews."
    },
    {
      "name": "weekSection",
      "type": {
        "type": "enum",
        "name": "WeekSection",
        "namespace": "com.toefly.events.common",
        "doc": "Section of the week.",
        "symbols": [
          "UNKNOWN",
          "READING",
          "LISTENING",
          "WRITING",
          "SPEAKING",
          "VOCABULARY",
          "GRAMMAR",
          "RESOURCES"
        ],
        "default": "UNKNOWN"
      },
      "doc": "Section of the week."
    },
    {
      "name": "estimatedMinutes",
      "type": "double",
      "doc": "Estimated minutes of the task."
    },
    {
      "name": "localDate",
      "type": {
        "type": "int",
        "logicalType": "date"
      },
      "doc": "Day of the completion in the learner's time zone."
    },
    {
      "name": "attemptId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "Attempt that closed the task; null for manual marks."
    },
    {
      "name": "progressPercent",
      "type": "double",
      "doc": "Progress of the week after the task, 0 to 100."
    }
  ]
}
